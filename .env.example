# ─────────────────────────────────────────────
#  .env.example – Copy this to .env and fill in
# ─────────────────────────────────────────────

# Your name (used in JARVIS greetings)
USER_NAME=Sir

# OpenAI API key (get one at https://platform.openai.com)
# Leave empty to use the offline fallback mode.
OPENAI_API_KEY=

# Which OpenAI model to use (gpt-3.5-turbo is fast & cheap)
# Options: gpt-3.5-turbo | gpt-4 | gpt-4o
AI_MODEL=gpt-3.5-turbo
