# ─────────────────────────────────────────────
#  .env.example – Copy this to .env and fill in
# ─────────────────────────────────────────────

# Your name (used in JARVIS greetings)
USER_NAME=Sir

# Provider: openai | openrouter | grok | groq
AI_PROVIDER=openai

# API key for the selected provider.
# Leave empty to use the offline fallback mode.
OPENAI_API_KEY=

# Model identifier accepted by the selected provider.
AI_MODEL=gpt-3.5-turbo

# Maximum time for an AI request, in seconds.
AI_REQUEST_TIMEOUT=30

# Number of automatic retries for transient provider errors.
AI_MAX_RETRIES=1
